{
  "name": "proofline",
  "version": "1.0.0",
  "description": "Verifiable Proof-of-Work Engineering Talent Infrastructure",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "seed": "node server/scripts/seed.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "test": "node server/scripts/seed.js"
  },
  "keywords": [
    "proof-of-work",
    "engineering-talent",
    "developer-platform",
    "adr",
    "verification",
    "hr-tech"
  ],
  "author": "PROOFLINE Architecture Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2"
  }
}
