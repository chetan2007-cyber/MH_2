# PROOFLINE Talent Infrastructure Environment Variables
# Copy to .env and configure with real credentials

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/proofline
AUTH_SECRET=your_super_secure_jwt_secret_here
JWT_SECRET=your_super_secure_jwt_secret_here
SESSION_EXPIRY=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional AI Verification Service
AI_API_KEY=

# Optional GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Email Delivery Service
EMAIL_API_KEY=
EMAIL_FROM=notifications@proofline.dev
